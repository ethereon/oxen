Screen {
    layout: vertical;
}

#views {
    height: 1fr;
}

.view-slot {
    width: 100%;
    height: 100%;
}

TaskBrowser {
    width: 100%;
    height: 100%;
}

#task-pane {
    width: 32;
    min-width: 20;
    height: 100%;
    border-right: solid $primary;
}

#output-pane {
    width: 1fr;
    height: 100%;
}

.pane-title, .task-header {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

.pane-title {
    background: $surface;
}

TaskList {
    height: 1fr;
}

TaskListItem {
    height: 1;
    padding: 0 1;
}

TaskLog {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

TaskLog > Log, TaskLog > RichLog {
    width: 100%;
    height: 100%;
}

TaskPanel {
    width: 1fr;
    height: 1fr;
    border: round $primary-background;
}

TaskPanel:focus-within {
    border: round $primary;
}

.task-layout-split {
    width: 1fr;
    height: 1fr;
}

.task-layout-split.horizontal {
    layout: horizontal;
}

.task-layout-split.vertical {
    layout: vertical;
}
